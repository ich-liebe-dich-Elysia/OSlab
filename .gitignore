# ====================================
# OSlab 项目 .gitignore
# ====================================

# 忽略 xv6 源码目录（参考用，不上传）
xv6-riscv/

# 忽略 QEMU 源码目录（参考用，不上传）
qemu-7.2.0/

# 忽略实验答案和文档目录
code/

# 忽略 VS Code 配置
.vscode/

# ====================================
# 通用编译产物
# ====================================

# 目标文件
*.o
*.obj
*.elf
*.out
*.bin

# 可执行文件
kernel/kernel
kernel/*.asm
kernel/*.img

# 汇编输出
*.s
*.S.o

# 依赖文件
*.d
*.dep

# 链接产物
*.map

# ====================================
# 编辑器和IDE
# ====================================

# Vim
*.swp
*.swo
*~
.*.swp

# Emacs
*~
\#*\#
.\#*

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# ====================================
# 操作系统文件
# ====================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ====================================
# 其他
# ====================================

# 备份文件
*.bak
*.backup
*.old

# 日志文件
*.log

# 临时文件
tmp/
temp/
*.tmp

# 压缩文件（可选）
# *.zip
# *.tar.gz
# *.rar

